# SERVER ONLY. Copy to .env.pilot.local (ignored); never copy this file to apps/mobile.
APP_ENV=pilot
NODE_ENV=production
PILOT_SYNTHETIC_ONLY=true
PILOT_ALLOW_COMMERCIAL_MESSAGES=false
LOCAL_AUTH_STUB=false
ENABLE_TEST_OTP=false
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=
# For a provider-specific CA, set NODE_EXTRA_CA_CERTS before starting the Node process.
# Use a trusted certificate file mounted read-only on the server; never disable TLS verification.
NEXT_PUBLIC_APP_URL=
ADMIN_EMAIL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=pilot-work-order-media
MEDIA_SIGNING_SECRET=
TRUST_PROXY=false
OTP_PROVIDER=
# Optional, only after explicit authorization of commercial SMS:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Public mobile configuration is set separately in apps/mobile/.env.local or EAS:
EXPO_PUBLIC_API_URL=
EAS_PROJECT_ID=
