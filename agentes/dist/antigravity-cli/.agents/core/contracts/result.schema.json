{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/universal-agents/result.schema.json",
  "title": "Work result",
  "type": "object",
  "required": ["status", "summary", "files", "checks", "risks", "pending"],
  "properties": {
    "status": {"enum": ["completed", "partial", "blocked", "no_change"]},
    "summary": {"type": "string"},
    "files": {"type": "array", "items": {"type": "object", "required": ["path", "reason"], "properties": {"path": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}},
    "checks": {"type": "array", "items": {"type": "object", "required": ["check", "status", "command", "result", "reason"], "properties": {"check": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed", "not_run", "not_applicable", "blocked"]}, "command": {"type": ["string", "null"]}, "result": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"]}, "artifact": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "pending": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
