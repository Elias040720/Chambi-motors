{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/universal-agents/evidence.schema.json",
  "title": "Documentary claim with unverified provenance",
  "type": "object",
  "required": ["check", "claim", "provenance"],
  "properties": {
    "check": {"type": "string", "minLength": 1},
    "claim": {
      "type": "object",
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["passed", "failed", "not_run", "not_applicable", "blocked"]},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["producer", "event_id", "event_type", "observed_at", "artifact_digest", "signer_key_id", "signature"],
          "properties": {
            "producer": {"type": "string", "minLength": 1},
            "event_id": {"type": "string", "minLength": 1},
            "event_type": {"enum": ["process_exit", "manual_observation"]},
            "observed_at": {"type": "string", "format": "date-time"},
            "artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "signer_key_id": {"type": "string", "minLength": 1},
            "signature": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
