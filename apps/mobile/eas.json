{
  "cli": {
    "version": ">= 26.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "pilot"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "pilot": {
      "extends": "preview",
      "node": "22.23.2",
      "pnpm": "11.25.0",
      "developmentClient": false,
      "credentialsSource": "remote",
      "env": {
        "APP_VARIANT": "pilot",
        "EXPO_PUBLIC_PILOT_OFFLINE": "true"
      },
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "APP_VARIANT": "production"
      }
    }
  }
}
